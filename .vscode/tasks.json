{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-infra-up",
      "type": "shell",
      "command": "podman compose up -d rabbitmq order-db payment-db inventory-db",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "infra"
      },
      "problemMatcher": []
    },
    {
      "label": "docker-infra-down",
      "type": "shell",
      "command": "podman compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "build: Order.API",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Services/Order/SagaEcommerce.Order.API/SagaEcommerce.Order.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "build: Inventory.API",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Services/Inventory/SagaEcommerce.Inventory.API/SagaEcommerce.Inventory.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "infra-up + build: Order.API",
      "dependsOn": ["docker-infra-up", "build: Order.API"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "infra-up + build: Inventory.API",
      "dependsOn": ["docker-infra-up", "build: Inventory.API"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
